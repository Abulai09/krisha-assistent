# Подключение к PostgreSQL (docker compose up -d поднимает его на порту 5434).
DATABASE_URL="postgresql://dealfinder:dealfinder_local@localhost:5434/deal_finder?schema=public"
# Или Supabase: укажите Session pooler (порт 5432). Worker и миграции работают через него (нужен advisory lock),
# а сайт на Vercel сам переключается на Transaction pooler (6543) — см. DATABASE_POOL_MODE ниже.
# Своя схема (?schema=deal_finder) — таблицы не попадут в публичный Data API Supabase и не смешаются с другими.
# Корневой сертификат Supabase лежит в certs/ (Settings → Database → SSL Configuration) — соединение проверяется.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=deal_finder&sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt"

# Соединений с БД на процесс (необязательно). По умолчанию: на Vercel 2, иначе 5.
# Supabase Session pooler держит всего 15 соединений на весь проект — worker и все функции Vercel вместе.
# DATABASE_POOL_MAX=5
# Режим Supabase pooler: session (5432) или transaction (6543). По умолчанию: на Vercel transaction, иначе session.
# DATABASE_POOL_MODE=session

# База для интеграционных тестов (создаётся docker/init-test-db.sql).
DATABASE_URL_TEST="postgresql://dealfinder:dealfinder_local@localhost:5434/deal_finder_test?schema=public"

# Секрет подписи cookie сессий. Минимум 32 символа. Без него вход на сайт и в «Управление» выключен. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Общий пароль пользователей для входа и регистрации (от 8 символов). Пусто — сайт открыт всем.
# Кто может войти, решает администратор в разделе «Управление» → «Пользователи».
# Администратор входит личным паролем: создать — npm run admin:create -- <логин> "<Имя>".
SITE_PASSWORD=""

# Интервал автоматического обновления данных worker'ом (минуты).
WORKER_INTERVAL_MINUTES=60

# Минимальный интервал между ручными запусками обновления (минуты).
MANUAL_RUN_COOLDOWN_MINUTES=5

# Источники, которые worker обновляет по расписанию (через запятую): synthetic, krisha-web.
# Для рабочей базы с Krisha.kz synthetic не нужен — тестовые данные не показываются рядом с реальными.
SCHEDULED_SOURCES=synthetic

# Ограничения импорта CSV/JSON: размер файла (МБ) и число строк.
IMPORT_MAX_FILE_MB=5
IMPORT_MAX_ROWS=20000

# Сбор со страниц krisha.kz (источник krisha-web). Выключен по умолчанию — прочтите docs/adr/0002.
# Чтобы обновлять по расписанию, добавьте krisha-web в SCHEDULED_SOURCES.
KRISHA_WEB_ENABLED=false
KRISHA_WEB_MAX_PAGES=5
KRISHA_WEB_DELAY_MS=4000
