# Подключение к PostgreSQL (docker compose up -d поднимает его на порту 5434).
DATABASE_URL="postgresql://dealfinder:dealfinder_local@localhost:5434/deal_finder?schema=public"
# Или Supabase: только Session pooler (порт 5432) — Transaction pooler (6543) ломает advisory lock.
# Своя схема (?schema=deal_finder) — таблицы не попадут в публичный Data API Supabase и не смешаются с другими.
# Корневой сертификат Supabase лежит в certs/ (Settings → Database → SSL Configuration) — соединение проверяется.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=deal_finder&sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt"

# База для интеграционных тестов (создаётся docker/init-test-db.sql).
DATABASE_URL_TEST="postgresql://dealfinder:dealfinder_local@localhost:5434/deal_finder_test?schema=public"

# Пароль администратора для /admin. Минимум 16 символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=""

# Секрет подписи cookie сессии администратора. Минимум 32 символа, генерируется так же.
SESSION_SECRET=""

# Интервал автоматического обновления данных worker'ом (минуты).
WORKER_INTERVAL_MINUTES=60

# Минимальный интервал между ручными запусками обновления (минуты).
MANUAL_RUN_COOLDOWN_MINUTES=5

# Сбор со страниц krisha.kz (источник krisha-web). Выключен по умолчанию — прочтите docs/adr/0002.
# Чтобы обновлять по расписанию, добавьте krisha-web в SCHEDULED_SOURCES.
KRISHA_WEB_ENABLED=false
KRISHA_WEB_MAX_PAGES=5
KRISHA_WEB_DELAY_MS=4000
