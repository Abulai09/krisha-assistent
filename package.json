{
  "name": "krisha-assistent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "worker:once": "tsx --env-file-if-exists=.env src/worker/cli.ts once",
    "collect": "tsx --env-file-if-exists=.env src/worker/cli.ts collect",
    "import": "tsx --env-file-if-exists=.env src/worker/cli.ts import",
    "revalue": "tsx --env-file-if-exists=.env src/worker/cli.ts revalue",
    "seed": "tsx --env-file-if-exists=.env src/worker/cli.ts collect synthetic",
    "admin:create": "tsx --env-file-if-exists=.env src/worker/cli.ts admin-create",
    "backup": "tsx --env-file-if-exists=.env src/worker/cli.ts backup"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "node-html-parser": "^7.1.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
