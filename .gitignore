# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js / сборка
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Prisma Client генерируется при npm install (postinstall)
/src/generated/prisma

# env: секреты (пароль БД, ADMIN_TOKEN, SESSION_SECRET) — только .env.example в git
.env*
!.env.example

# ключи и сертификаты с секретами. certs/*.crt — публичный корневой сертификат Supabase, он в git
*.pem
*.key

# тесты
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# логи (logs/ — worker по расписанию, scripts/worker-once.cmd)
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# резервные копии БД (npm run backup) — содержат данные и хеши паролей
/backups

# входящие файлы импорта (могут содержать чужие данные)
/data/inbox/*
!/data/inbox/.gitkeep

# личные настройки Claude Code (общие skills в .claude/skills — в git)
.claude/settings.local.json

# vercel
.vercel

# ОС и редакторы
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
